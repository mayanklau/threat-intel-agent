# Threat Intelligence Agent - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=false

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=["*"]
# API_API_KEY=your-api-key-here  # Uncomment to enable API authentication

# =============================================================================
# SLM Configuration
# =============================================================================
SLM_MODEL_SIZE=medium  # small (~30M params), medium (~110M), large (~340M)
SLM_VOCAB_SIZE=50000
SLM_MAX_SEQ_LENGTH=512
SLM_USE_FLASH_ATTENTION=false
SLM_GRADIENT_CHECKPOINTING=false
SLM_DEVICE=cpu  # cpu or cuda

# =============================================================================
# Memory Configuration
# =============================================================================
# Redis (Working Memory)
MEMORY_REDIS_URL=redis://localhost:6379/0
# MEMORY_REDIS_PASSWORD=your-redis-password

# ChromaDB (Vector Store)
MEMORY_CHROMA_HOST=localhost
MEMORY_CHROMA_PORT=8000
MEMORY_CHROMA_PERSIST_DIRECTORY=./data/embeddings

# Bead Memory
MEMORY_BEAD_TEMPORAL_WINDOW=604800  # 7 days in seconds
MEMORY_BEAD_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# Threat Feed API Keys
# =============================================================================
# AlienVault OTX - Get key from https://otx.alienvault.com/
OTX_API_KEY=

# VirusTotal - Get key from https://www.virustotal.com/
VIRUSTOTAL_API_KEY=

# AbuseIPDB - Get key from https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# MISP Instance
MISP_URL=
MISP_API_KEY=
THREATFEED_MISP_VERIFY_SSL=true

# STIX/TAXII Server
TAXII_URL=
TAXII_USERNAME=
TAXII_PASSWORD=

# =============================================================================
# Threat Feed Settings
# =============================================================================
THREATFEED_CACHE_TTL=3600  # Cache TTL in seconds
THREATFEED_CACHE_MAX_SIZE=10000
THREATFEED_RATE_LIMIT_REQUESTS=100
THREATFEED_RATE_LIMIT_PERIOD=60
THREATFEED_REQUEST_TIMEOUT=30
THREATFEED_MAX_RETRIES=3

# =============================================================================
# Agent Configuration
# =============================================================================
AGENT_MAX_CONCURRENT_TASKS=10
AGENT_TASK_TIMEOUT=300
AGENT_BATCH_SIZE=100
AGENT_ENRICHMENT_PROVIDERS=["otx","virustotal","abuseipdb"]
AGENT_MIN_CONFIDENCE_THRESHOLD=0.5
AGENT_AUTO_CORRELATE=true
AGENT_MAX_INVESTIGATION_DEPTH=5

# =============================================================================
# Monitoring (Optional)
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
